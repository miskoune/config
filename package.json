{
  "name": "@miskoune/config",
  "version": "1.1.2",
  "description": "Reusable ESLint and Prettier configuration for TypeScript and React projects.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "config",
    "eslint",
    "eslint-config",
    "prettier",
    "prettier-config",
    "typescript"
  ],
  "author": "miskoune",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miskoune/config.git"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "semantic-release"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.58.0"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^26.1.1",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.8",
    "typescript": "^7.0.2"
  }
}
